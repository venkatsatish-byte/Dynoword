# Copy to .env for local builds, or add these in Netlify → Site configuration → Environment variables.
# Billing (sign-in, 7-day trial, $5/month) switches on only when the Firebase values are set.

# Firebase web app settings (Firebase console → Project settings → Your apps → Web app). These are public.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Server-side only — keep secret. Used by the Netlify Functions in netlify/functions.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PRICE_ID=price_...
